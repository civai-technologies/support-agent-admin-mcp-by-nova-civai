{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
  "name": "support-agent-admin-by-nova",
  "displayName": "Support Agent Admin by Nova (CIVAI)",
  "version": "1.1.0",
  "description": "I manage your Support Agent CRM, pipeline analytics, follow-ups, Leads Discovery, and workspace output (Sheets, Docs, Calendar, research)",
  "author": {
    "name": "CIVAI TECHNOLOGIES",
    "email": "nifemialpine@nova.civai.co",
    "url": "https://nova.civai.co"
  },
  "homepage": "https://nova.civai.co/agent/support-agent-admin",
  "repository": "https://github.com/civai-technologies/support-agent-admin-mcp-by-nova-civai",
  "license": "MIT",
  "keywords": [
    "crm",
    "support-agent",
    "outreach",
    "whatsapp-crm",
    "lead-management"
  ],
  "icon": "./assets/logo.svg",
  "documentationUrl": "https://nova.civai.co/agent/support-agent-admin",
  "supportUrl": "https://nova.civai.co/api-keys",
  "privacyPolicyUrl": "https://nova.civai.co/privacy",
  "termsOfServiceUrl": "https://nova.civai.co/terms",
  "userConfig": {
    "nova_api_key": {
      "type": "string",
      "title": "Nova API key",
      "description": "Programmatic Nova API key from https://nova.civai.co/api-keys",
      "required": true,
      "sensitive": true
    }
  },
  "mcpServers": {
    "support-agent-admin-by-nova": {
      "type": "http",
      "url": "https://nova.civai.co/mcp/agents/support-agent-admin",
      "headers": {
        "Authorization": "Bearer ${user_config.nova_api_key}"
      }
    }
  }
}
